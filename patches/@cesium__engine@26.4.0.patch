+++ b/Source/Renderer/ComputeEngine.js
@@ -63,6 +63,16 @@ function createRenderState(width, height) {
 }
 
 ComputeEngine.prototype.execute = function (computeCommand) {
+  // A command canceled after it was queued, or one that already ran (the dynamic environment
+  // map can queue the same command twice in a frame), may point at freed resources: skip it,
+  // and let its owner know.
+  if (computeCommand.canceled === true) {
+    if (defined(computeCommand.postExecute)) {
+      computeCommand.postExecute(undefined);
+    }
+    return;
+  }
+
   //>>includeStart('debug', pragmas.debug);
   Check.defined("computeCommand", computeCommand);
   //>>includeEnd('debug');
