{
  "_note": "Copy to holo-worker.json next to holo-splat-worker.mjs and set the paths of this machine. The eogs-plus command is an example: use the one your EOGS++ release documents.",
  "ffmpeg": "/usr/bin/ffmpeg",
  "sfm": "glomap",
  "colmap": "/usr/local/bin/colmap",
  "glomap": "/usr/local/bin/glomap",
  "python": "/opt/holo/venv/bin/python",
  "sfmGpu": true,
  "exhaustiveUpTo": 250,
  "vocabTree": "/opt/holo/vocab_tree_flickr100K_words256K.bin",
  "methods": {
    "gsplat": { "repo": "/opt/holo/gsplat" },
    "gsplat-2dgs": { "repo": "/opt/holo/gsplat" },
    "brush": { "program": "/opt/holo/brush/brush_app", "revision": "v0.2.0" },
    "opensplat": { "program": "/opt/holo/OpenSplat/build/opensplat" },
    "eogs-plus": {
      "repo": "/opt/holo/eogs-plus",
      "train": ["{python}", "{repo}/train.py", "--data", "{data}", "--out", "{train}", "--iterations", "{iterations}"],
      "check": ["{python}", "-c", "import torch; assert torch.cuda.is_available()"]
    }
  }
}
