{
  "_note": "Copy to holo-worker.json next to holo-splat-worker.mjs and set the paths of this machine. EOGS++ runs through eogs/holo_eogs.py (docs/GAUSSIAN_SPLATS.md, \"Satellite images with EOGS++\"); its python is the EOGS++ environment's. Leave out its train to use the default command; this one also keeps each DSM.",
  "ffmpeg": "/usr/bin/ffmpeg",
  "sfm": "glomap",
  "colmap": "/usr/local/bin/colmap",
  "glomap": "/usr/local/bin/glomap",
  "python": "/opt/holo/venv/bin/python",
  "sfmGpu": true,
  "exhaustiveUpTo": 250,
  "vocabTree": "/opt/holo/vocab_tree_flickr100K_words256K.bin",
  "methods": {
    "gsplat": {
      "repo": "/opt/holo/gsplat"
    },
    "gsplat-2dgs": {
      "repo": "/opt/holo/gsplat"
    },
    "brush": {
      "program": "/opt/holo/brush/brush_app",
      "revision": "v0.2.0"
    },
    "opensplat": {
      "program": "/opt/holo/OpenSplat/build/opensplat"
    },
    "eogs-plus": {
      "repo": "/opt/holo/eogs-plus",
      "python": "/opt/conda/envs/eogsplus/bin/python",
      "train": [
        "{python}",
        "{here}/eogs/holo_eogs.py",
        "run",
        "--eogs",
        "{repo}",
        "--data",
        "{data}",
        "--train",
        "{train}",
        "--iterations",
        "{iterations}",
        "--max-size",
        "{resolution}",
        "--keep-dsm",
        "/srv/holo/eogs-dsm"
      ]
    }
  }
}
