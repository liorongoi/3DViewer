# VIEWER front end settings: copy to /etc/viewer/caddy.env (deploy/caddy/README.md).
VIEWER_HOST=viewer.internal
TLS_CERT=/etc/viewer/tls/viewer-chain.pem
TLS_KEY=/etc/viewer/tls/viewer.key
WEB_ROOT=/opt/viewer/web
FILES_ROOT=/var/lib/viewer/storage/files
API_UPSTREAM=127.0.0.1:8787
LOG_DIR=/var/log/viewer
