#!/usr/bin/env bash
# holo: run the HOLO server installed in a home folder by install-user.sh. No root needed.
#
#   holo status       is it running, and where to open it
#   holo start        start it (also: stop, restart)
#   holo address      the address to open in a browser or give the Windows app
#   holo check        what this machine can do (processor, memory, disk, graphics card)
#   holo logs [n]     the last n lines of the server's log (default 50)
#   holo report       a file to send for support, with addresses and names taken out
#   holo backup       a backup of the database and models, in backups/ (keeps 14)
#   holo password     the first admin password, while its file is kept
#   holo uninstall    stop it and remove the program; your data, settings and backups stay
#
# It uses systemd's per-user services when the machine has them (restart after a crash, start
# at boot when "linger" is allowed), and otherwise runs both processes itself with a restart loop
# and starts them at boot from your crontab.
set -uo pipefail

D=""
if [[ "${1:-}" == --home ]]; then D="$2"; shift 2; fi
D="${D:-${HOLO_HOME:-$HOME/holo}}"
CUR="$D/current"
ENV="$D/settings/viewer.env" CENV="$D/settings/caddy.env"
UNITS="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
cmd="${1:-help}"; shift || true

fail() { echo "holo: $*" >&2; exit 1; }
[[ -f "$ENV" && -L "$CUR" ]] || fail "HOLO is not installed in $D (run install-user.sh from the bundle)"
setting() { sed -n "s/^$1=//p" "$2" | tail -1; }
api_port() { setting PORT "$ENV"; }

# The settings files as KEY=VALUE pairs, without running them as a script.
load_env() { local l; while IFS= read -r l || [[ -n "$l" ]]; do [[ "$l" =~ ^[A-Z_][A-Z0-9_]*= ]] && export "$l"; done < "$1"; }

# Per-user services need systemd 240 or newer (append: logs) and "linger", which keeps them running
# after you log out and starts them at boot. Without linger they would stop at logout.
has_systemd_user() {
  command -v systemctl >/dev/null && systemctl --user show-environment >/dev/null 2>&1 || return 1
  (( $(systemctl --version 2>/dev/null | awk 'NR==1{print $2+0}') >= 240 )) || return 1
  [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" == yes ]] || loginctl enable-linger "$USER" >/dev/null 2>&1
}
mode() { cat "$D/settings/mode" 2>/dev/null || echo plain; }

healthy() {
  "$CUR/node/bin/node" -e "fetch('http://127.0.0.1:$(api_port)/api/health').then(async (r) => process.exit((await r.json()).ok ? 0 : 1), () => process.exit(1))" 2>/dev/null
}
wait_healthy() {
  local i
  for i in $(seq 1 120); do
    healthy && return 0
    # A wrong setting (exit 78) does not get better by waiting.
    [[ "$(tail -1 "$D/logs/server.log" 2>/dev/null)" == *"server stopped (exit 78)"* ]] && return 1
    [[ "$(mode)" == systemd ]] && [[ "$(systemctl --user show -p ExecMainStatus --value holo-server 2>/dev/null)" == 78 ]] && return 1
    sleep 1
  done
  return 1
}

# --- Per-user systemd services ------------------------------------------------------------------
write_units() {
  mkdir -p "$UNITS"
  cat > "$UNITS/holo-server.service" <<EOF
# Written by holo (HOLO in $D). The server and its job workers.
[Unit]
Description=HOLO server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=$CUR/server
EnvironmentFile=$ENV
Environment=NODE_ENV=production
ExecStart=$CUR/node/bin/node $CUR/server/dist/main.js
StandardOutput=append:$D/logs/server.log
StandardError=append:$D/logs/server.log
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=40
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
EOF
  cat > "$UNITS/holo-caddy.service" <<EOF
# Written by holo (HOLO in $D). The web front end: the app, the API and the model files on one address.
[Unit]
Description=HOLO web front end
After=holo-server.service

[Service]
Type=simple
EnvironmentFile=$CENV
Environment=XDG_DATA_HOME=$D/data/caddy XDG_CONFIG_HOME=$D/data/caddy
ExecStart=/bin/sh -c 'exec "$CUR/bin/caddy" run --config "$CUR/deploy/caddy/\$\${CADDY_CONFIG:-Caddyfile.user}" --adapter caddyfile'
StandardOutput=append:$D/logs/caddy-run.log
StandardError=append:$D/logs/caddy-run.log
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable holo-server holo-caddy >/dev/null 2>&1
}

# --- Without systemd: both processes in a restart loop of their own --------------------------------
run_loop() { # what: server | caddy
  local what="$1" code
  while true; do
    if [[ "$what" == server ]]; then
      (load_env "$ENV"; export NODE_ENV=production; cd "$CUR/server" && exec "$CUR/node/bin/node" "$CUR/server/dist/main.js") >> "$D/logs/server.log" 2>&1
    else
      (load_env "$CENV"; export XDG_DATA_HOME="$D/data/caddy" XDG_CONFIG_HOME="$D/data/caddy"; exec "$CUR/bin/caddy" run --config "$CUR/deploy/caddy/${CADDY_CONFIG:-Caddyfile.user}" --adapter caddyfile) >> "$D/logs/caddy-run.log" 2>&1
    fi
    code=$?
    echo "$(date -u +%FT%TZ) holo: $what stopped (exit $code)" >> "$D/logs/$what.log"
    [[ -f "$D/run/stopping" || $code -eq 78 ]] && break
    sleep 5
  done
}
plain_running() { local p; p="$(cat "$D/run/$1.pid" 2>/dev/null)" && [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null; }
plain_start() {
  rm -f "$D/run/stopping"
  echo "$(date -u +%FT%TZ) holo: starting" >> "$D/logs/server.log"
  local w
  for w in server caddy; do
    plain_running "$w" && continue
    setsid "$0" --home "$D" _loop "$w" < /dev/null > /dev/null 2>&1 &
    echo $! > "$D/run/$w.pid"
  done
}
plain_stop() {
  touch "$D/run/stopping"
  local w p
  for w in caddy server; do
    p="$(cat "$D/run/$w.pid" 2>/dev/null)" || continue
    kill -TERM -- "-$p" 2>/dev/null
    for _ in $(seq 1 40); do kill -0 "$p" 2>/dev/null || break; sleep 1; done
    kill -KILL -- "-$p" 2>/dev/null
    rm -f "$D/run/$w.pid"
  done
}
cron_lines() {
  echo "@reboot $D/holo start >/dev/null 2>&1 # holo"
  echo "30 2 * * * $D/holo backup --quiet >/dev/null 2>&1 # holo"
}
set_cron() { # on | off
  command -v crontab >/dev/null || return 0
  local now; now="$(crontab -l 2>/dev/null | grep -v '# holo$')"
  if [[ "$1" == on ]]; then printf '%s\n%s\n' "$now" "$(cron_lines)" | sed '/^$/d' | crontab -; else printf '%s\n' "$now" | sed '/^$/d' | crontab -; fi
}

address() {
  local ip scheme port host
  ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  if [[ "$(setting CADDY_CONFIG "$CENV")" == Caddyfile ]]; then
    scheme=https; port="$(setting HTTPS_PORT "$CENV")"; host="$(setting VIEWER_HOST "$CENV")"
  else
    scheme=http; port="$(setting HTTP_PORT "$CENV")"; host="${ip:-localhost}"
  fi
  echo "  Open in a browser on this network:  $scheme://$host:$port/"
  echo "  On this machine:                    $scheme://localhost:$port/"
}

case "$cmd" in
  _loop) run_loop "$1" ;;
  setup-services)
    if has_systemd_user; then
      write_units && echo systemd > "$D/settings/mode"
      set_cron off; command -v crontab >/dev/null && (crontab -l 2>/dev/null; echo "30 2 * * * $D/holo backup --quiet >/dev/null 2>&1 # holo") | crontab -
    else
      echo plain > "$D/settings/mode"; set_cron on
      command -v crontab >/dev/null || echo "  Note: this machine has no crontab, so HOLO does not start by itself after a restart. Type holo start after one."
    fi ;;
  start)
    if [[ "$(mode)" == systemd ]]; then systemctl --user start holo-server holo-caddy; else plain_start; fi
    if wait_healthy; then echo "HOLO is running."; address; else echo "HOLO did not start: holo logs shows why." >&2; exit 1; fi ;;
  stop)
    if [[ "$(mode)" == systemd ]]; then systemctl --user stop holo-caddy holo-server; else plain_stop; fi
    echo "HOLO is stopped." ;;
  restart)
    "$0" --home "$D" stop >/dev/null; exec "$0" --home "$D" start ;;
  status)
    if healthy; then echo "HOLO $(awk '/^viewer /{print $2}' "$CUR/VERSION") is running."; address; else echo "HOLO is not running. Start it with: holo start"; exit 3; fi ;;
  address) address ;;
  check) exec "$CUR/deploy/bin/holo-check" "$D" ;;
  logs) tail -n "${1:-50}" "$D/logs/server.log" 2>/dev/null || echo "No log yet." ;;
  report)
    # A file to send for support: the check and the recent log, with every network address,
    # host name, user name, e-mail and home folder taken out.
    out="$HOME/holo-report-$(date -u +%Y%m%d-%H%M).txt"
    host="$(hostname 2>/dev/null)"; fqdn="$(hostname -f 2>/dev/null)"
    vhost="$(setting VIEWER_HOST "$CENV")"
    {
      echo "HOLO $(awk '/^viewer /{print $2}' "$CUR/VERSION") support report, $(date -u +%FT%TZ)"
      echo "Mode: $(mode)"
      echo
      "$CUR/deploy/bin/holo-check" "$D"
      echo
      echo "Last 300 lines of the server log:"
      tail -n 300 "$D/logs/server.log" 2>/dev/null
      echo
      echo "Last 50 lines of the web front end's log:"
      tail -n 50 "$D/logs/caddy-run.log" 2>/dev/null
    } | sed -E \
        -e "s#$D#<holo folder>#g" -e "s#$HOME#<home>#g" \
        ${host:+-e "s#$host#<host>#g"} ${fqdn:+-e "s#$fqdn#<host>#g"} ${vhost:+-e "s#$vhost#<host>#g"} \
        -e "s#\b$USER\b#<user>#g" \
        -e 's#([0-9]{1,3}\.){3}[0-9]{1,3}#<ip>#g' \
        -e 's#\b([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\b#<ip>#g' -e 's#[0-9a-fA-F]*::[0-9a-fA-F:.]*[0-9a-fA-F]#<ip>#g' \
        -e 's#"(host|hostname|remoteAddress)":"[^"]*"#"\1":"<host>"#g' \
        -e 's#[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}#<email>#g' \
        -e 's#(https?|postgres(ql)?)://[^ "/]+#\1://<host>#g' > "$out"
    chmod 600 "$out"
    echo "Written: $out"
    echo "It has no addresses, host names or user names in it. Look it over, then send it." ;;
  password)
    if [[ -f "$D/settings/first-admin-password" ]]; then echo "First admin password: $(cat "$D/settings/first-admin-password")"
    else echo "The first admin password file was deleted. An admin can reset passwords on the admin page."; fi ;;
  backup)
    quiet=0; [[ "${1:-}" == --quiet ]] && quiet=1
    embedded="$(setting EMBEDDED_DB "$ENV")"
    # The built-in database is copied with the server stopped, for about a minute.
    if [[ "$embedded" == 1 ]] && healthy; then "$0" --home "$D" stop >/dev/null; restart=1; else restart=0; fi
    VIEWER_ENV="$ENV" BACKUP_DIR="$D/backups" "$CUR/deploy/bin/viewer-backup" > "$D/logs/backup.log" 2>&1; code=$?
    [[ $restart -eq 1 ]] && "$0" --home "$D" start >/dev/null
    if [[ $code -eq 0 ]]; then [[ $quiet -eq 1 ]] || echo "Backup done, in $D/backups"; else echo "The backup failed: $D/logs/backup.log says why." >&2; exit 1; fi ;;
  uninstall)
    "$0" --home "$D" stop >/dev/null
    if [[ "$(mode)" == systemd ]]; then
      systemctl --user disable holo-server holo-caddy >/dev/null 2>&1
      rm -f "$UNITS/holo-server.service" "$UNITS/holo-caddy.service"; systemctl --user daemon-reload
    fi
    set_cron off
    rm -f "$HOME/.local/bin/holo"
    rm -rf "$D/releases" "$D/current" "$D/run" "$D/holo"
    echo "HOLO is removed. Your models, settings and backups are still in $D (data, settings, backups)."
    echo "To delete them too: rm -r $D" ;;
  help|-h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) fail "unknown command $cmd (holo help lists them)" ;;
esac
