# VIEWER HTTPS front end: the web app, the API and the model files on one origin
# (deploy/caddy/README.md).
[Unit]
Description=VIEWER front end (Caddy)
Documentation=file:///opt/viewer/deploy/caddy/README.md
After=network-online.target viewer-server.service
Wants=network-online.target

[Service]
Type=notify
User=viewer
Group=viewer
EnvironmentFile=/etc/viewer/caddy.env
ExecStart=/opt/viewer/bin/caddy run --environ --config /opt/viewer/deploy/caddy/Caddyfile --adapter caddyfile
ExecReload=/opt/viewer/bin/caddy reload --config /opt/viewer/deploy/caddy/Caddyfile --adapter caddyfile --force
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
LimitNOFILE=1048576
# Ports 80 and 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
# Caddy keeps its own state (OCSP staples, the last config) in /var/lib/viewer/caddy.
Environment=XDG_DATA_HOME=/var/lib/viewer/caddy XDG_CONFIG_HOME=/var/lib/viewer/caddy
ReadWritePaths=/var/log/viewer -/var/lib/viewer/caddy
ReadOnlyPaths=/opt/viewer /opt/viewer-releases /var/lib/viewer/storage/files -/var/lib/viewer/basemaps /etc/viewer/tls

[Install]
WantedBy=multi-user.target
