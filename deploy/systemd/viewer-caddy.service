# VIEWER HTTPS front end: the web app, the API and the model files on one origin
# (deploy/caddy/README.md).
[Unit]
Description=VIEWER front end (Caddy)
Documentation=file:///opt/viewer/deploy/caddy/README.md
After=network-online.target viewer-server.service
Wants=network-online.target

[Service]
Type=notify
User=viewer
Group=viewer
EnvironmentFile=/etc/viewer/caddy.env
ExecStart=/usr/bin/caddy run --environ --config /opt/viewer/deploy/caddy/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /opt/viewer/deploy/caddy/Caddyfile --adapter caddyfile --force
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
LimitNOFILE=1048576
# Ports 80 and 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
ReadWritePaths=/var/log/viewer
ReadOnlyPaths=/opt/viewer /var/lib/viewer/storage/files /etc/viewer/tls

[Install]
WantedBy=multi-user.target
