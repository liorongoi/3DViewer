# VIEWER API server and job workers (docs/OPERATIONS.md).
# Install: cp deploy/systemd/*.service deploy/systemd/*.timer /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable --now viewer-server viewer-caddy viewer-backup.timer
[Unit]
Description=VIEWER server (API and job workers)
Documentation=file:///opt/viewer/docs/OPERATIONS.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=viewer
Group=viewer
WorkingDirectory=/opt/viewer/server
EnvironmentFile=/etc/viewer/viewer.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/viewer/server/dist/main.js
# A crash or a fatal error restarts the server; jobs in flight are taken up again when their
# lease ends. Exit code 78 is a wrong setting: restarting would not help, so it stays stopped
# and `systemctl status viewer-server` shows the message naming the setting.
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
# The server gives itself 30 s to finish requests and the current job step.
TimeoutStopSec=40
KillSignal=SIGTERM
LimitNOFILE=65536

# Hardening: the server writes only to its data and log folders.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/viewer /var/log/viewer
UMask=0027

[Install]
WantedBy=multi-user.target
