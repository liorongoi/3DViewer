# VIEWER server settings: copy to /etc/viewer/viewer.env (owner root, group viewer, mode 0640).
# The server checks every value when it starts; a wrong one stops it with a message naming the
# setting (exit code 78). docs/OPERATIONS.md explains each one.

# --- Required in production ---------------------------------------------------------------
# PostgreSQL 15 or newer. The database user owns the database (the server creates its tables).
DATABASE_URL=postgres://viewer:CHANGE-ME@db.internal:5432/viewer
# Where the server keeps its data. STORAGE_DIR defaults to DATA_DIR/storage.
DATA_DIR=/var/lib/viewer
# STORAGE_DIR=/var/lib/viewer/storage
# The first admin password, 12 characters or more. Read on first start only; after that the
# admin page changes it. ADMIN_PASSWORD_RESET=1 replaces a stored one (then remove both lines).
ADMIN_PASSWORD=CHANGE-ME-at-least-12-chars
# ADMIN_PASSWORD_RESET=0

# --- Network ----------------------------------------------------------------------------
# Keep the server on 127.0.0.1 behind Caddy: it trusts the client address Caddy passes on.
HOST=127.0.0.1
PORT=8787
# Other origins allowed to call the API, comma separated. Not needed for the web app served by
# Caddy on the same origin, nor for the desktop app, whose main process forwards its requests.
# CORS_ORIGINS=https://portal.example

# --- Upload processing ------------------------------------------------------------------
# Run the job workers in this process; WORKERS=0 for an API-only machine.
WORKERS=1
# ClamAV client; without it uploads are published with a "not scanned" warning.
CLAMDSCAN=/usr/bin/clamdscan
# FBX converter; without it FBX uploads fail.
FBX2GLTF=/opt/viewer/bin/FBX2glTF
# Validator errors stop a publish (1) or are shown as warnings (0, default).
STRICT_VALIDATION=0
# Seconds before a crashed worker's job is taken up by another worker.
JOB_LEASE_SECONDS=300
# Thumbnails: where the web app is served (this host's https address) and the Chromium binary.
# THUMBNAIL_WEB_URL=https://viewer.internal/
# CHROMIUM=/usr/bin/chromium

# --- Protection -------------------------------------------------------------------------
# Changes (POST, PUT, PATCH, DELETE) one address may make per minute; 0 turns the limit off.
# Upload chunks do not count.
WRITE_RATE_LIMIT=600
# Longest a single database statement may run, in milliseconds.
DB_STATEMENT_TIMEOUT_MS=60000

# --- Audit ------------------------------------------------------------------------------
# Send the audit log to the SIEM as CEF: udp://, tcp:// or tls://host:port.
# AUDIT_SYSLOG=tls://siem.internal:6514

# --- Never in production ----------------------------------------------------------------
# SEED_SAMPLES=0     the sample library is for demonstrations (off in production)
# EMBEDDED_DB=0      the embedded database is for a single workstation
