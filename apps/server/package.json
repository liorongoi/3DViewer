{
  "name": "@viewer/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --ssr src/main.ts --outDir dist --emptyOutDir",
    "start": "node dist/main.js",
    "dev": "vite build --ssr src/main.ts --outDir dist --emptyOutDir && node dist/main.js",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "3d-tiles-validator": "0.6.1",
    "@electric-sql/pglite": "0.5.14",
    "@fastify/swagger": "9.9.3",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@viewer/core": "workspace:*",
    "@viewer/shared": "workspace:*",
    "fastify": "5.12.7",
    "fflate": "0.8.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "vite": "8.3.5"
  },
  "optionalDependencies": {
    "playwright-core": "1.64.1"
  }
